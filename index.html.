/* =========================================
   THEME
========================================= */

function toggleTheme() {

    database.settings.theme =
        database.settings.theme === "dark" ? "light" : "dark";

    saveDatabase();

    applyTheme();
}

function applyTheme() {

    if (database.settings.theme === "dark") {
        document.body.classList.add("dark");
    } else {
        document.body.classList.remove("dark");
    }
}

/* =========================================
   BACKUP AND RESTORE
========================================= */

function exportBackup() {

    const backup = {
        application: "Al-Juman Laboratory",
        version: "1.0",
        createdAt: new Date().toISOString(),
        database: database
    };

    const blob = new Blob(
        [JSON.stringify(backup,null,2)],
        {type:"application/json"}
    );

    const url = URL.createObjectURL(blob);

    const link = document.createElement("a");

    link.href = url;
    link.download = `Al-Juman-Lab-Backup-${todayDate()}.json`;

    link.click();

    URL.revokeObjectURL(url);

    showToast("تم إنشاء النسخة الاحتياطية");
}

function restoreBackup(event) {

    const file = event.target.files[0];

    if (!file) return;

    const reader = new FileReader();

    reader.onload = function() {

        try {

            const backup = JSON.parse(reader.result);

            const restoredDatabase = backup.database || backup;

            if (!restoredDatabase.patients || !restoredDatabase.reports) {
                throw new Error("Invalid backup");
            }

            if (!confirm("سيتم استبدال البيانات الحالية. هل تريد المتابعة؟")) {
                return;
            }

            database = restoredDatabase;

            saveDatabase();

            alert("تمت استعادة النسخة الاحتياطية بنجاح");

            location.reload();

        } catch (error) {
            alert("ملف النسخة الاحتياطية غير صالح");
        }
    };

    reader.readAsText(file);
}

/* =========================================
   CLEAR DATA
========================================= */

function clearAllData() {

    if (!confirm("تحذير: سيتم حذف جميع المرضى والتقارير. هل أنت متأكد؟")) {
        return;
    }

    if (!confirm("تأكيد أخير: حذف جميع البيانات نهائياً؟")) {
        return;
    }

    database.patients = [];
    database.reports = [];
    database.settings.patientSequence = 1;
    database.settings.reportSequence = 1;

    saveDatabase();

    location.reload();
}

/* =========================================
   UTILITIES
========================================= */

function showToast(message) {

    const toast = document.getElementById("toast");

    toast.textContent = message;

    toast.style.display = "block";

    setTimeout(() => {
        toast.style.display = "none";
    },3000);
}

function escapeHTML(value) {

    return String(value ?? "")
        .replaceAll("&","&amp;")
        .replaceAll("<","&lt;")
        .replaceAll(">","&gt;")
        .replaceAll('"',"&quot;")
        .replaceAll("'","&#039;");
}

function escapeAttribute(value) {
    return escapeHTML(value);
}

/* =========================================
   START APPLICATION
========================================= */

initializeApp();
loadSettingsIntoForm();

</script>

