========================================= */

function generateNextIDs() {
    const year = new Date().getFullYear();

    const patientNumber = String(database.settings.patientSequence || 1).padStart(4,"0");
    const reportNumber = String(database.settings.reportSequence || 1).padStart(4,"0");

    document.getElementById("patientId").value = `${year}-${patientNumber}`;
    document.getElementById("reportNumber").value = `${year}-${reportNumber}`;
}

/* =========================================
   TEST SELECTION
========================================= */

function renderTestSelection() {
    const container = document.getElementById("testSelection");
    const search = document.getElementById("testSearch").value.toLowerCase();

    const categories = [...new Set(database.tests.map(test => test.category))];

    let html = "";

    categories.forEach(category => {

        const categoryTests = database.tests.filter(test =>
            test.category === category &&
            test.name.toLowerCase().includes(search)
        );

        if (categoryTests.length === 0) return;

        html += `
            <div class="test-category">
                <h3>${category}</h3>
                <div class="test-list">
        `;

        categoryTests.forEach(test => {

            const checked = selectedTests.includes(test.name) ? "checked" : "";

            html += `
                <label class="test-option">
                    <input type="checkbox"
                           ${checked}
                           onchange="toggleTestSelection('${escapeAttribute(test.name)}')">
                    <span>${escapeHTML(test.name)}</span>
                </label>
            `;
        });

        html += `
                </div>
            </div>
        `;
    });

    container.innerHTML = html || "<div class='empty-state'>لا توجد تحاليل</div>";

    renderResultInputs();
}

function toggleTestSelection(testName) {
    if (selectedTests.includes(testName)) {
        selectedTests = selectedTests.filter(name => name !== testName);
    } else {
        selectedTests.push(testName);
    }

    renderTestSelection();
}

function getSelectedTestObjects() {
    return database.tests.filter(test => selectedTests.includes(test.name));
}

/* =========================================
   RESULT ENTRY
========================================= */

function renderResultInputs() {
    const container = document.getElementById("resultInputs");

    if (selectedTests.length === 0) {
        container.innerHTML = "<div class='empty-state'>اختر التحاليل أولاً</div>";
        return;
    }

    const gender = document.getElementById("patientGender").value;

    let html = "";

    selectedTests.forEach(testName => {

        const test = database.tests.find(item => item.name === testName);

        if (!test) return;

        let referenceRange = test.range || "";

        if (gender === "Male" && test.male) {
            referenceRange = test.male;
        }

        if (gender === "Female" && test.female) {
            referenceRange = test.female;
        }

        html += `
            <div class="result-row" data-test="${escapeAttribute(test.name)}">
                <div>
                    <strong>${escapeHTML(test.name)}</strong>
                    <small>${escapeHTML(test.unit || "")}</small>
                </div>

                <input class="result-value"
                       placeholder="Result"
                       data-name="${escapeAttribute(test.name)}">

                <input class="unit-input"
                       value="${escapeAttribute(test.unit || "")}"
                       placeholder="Unit">

                <input class="range-input"
                       value="${escapeAttribute(referenceRange)}"
                       placeholder="Reference Range">
            </div>
        `;
    });

    container.innerHTML = html;
}

/* =========================================
   PATIENT AND REPORT SAVING
========================================= */

document.getElementById("patientForm").addEventListener("submit", function(event) {

    event.preventDefault();

    if (selectedTests.length === 0) {
        alert("يرجى اختيار تحليل واحد على الأقل");
        return;
    }

    const patientId = document.getElementById("patientId").value;
    const reportNumber = document.getElementById("reportNumber").value;

    const patient = {
        id: patientId,
        name: document.getElementById("patientName").value.trim(),
        age: document.getElementById("patientAge").value,
        ageUnit: document.getElementById("ageUnit").value,
        gender: document.getElementById("patientGender").value,
        doctor: document.getElementById("doctorName").value,
        notes: document.getElementById("patientNotes").value,
        date: document.getElementById("analysisDate").value
    };

    const existingPatient = database.patients.find(item => item.id === patientId);

    if (!existingPatient) {
        database.patients.push(patient);
        database.settings.patientSequence++;
    }

    const results = [];

    document.querySelectorAll(".result-row").forEach(row => {

        const testName = row.dataset.test;
        const resultValue = row.querySelector(".result-value").value;
        const unit = row.querySelector(".unit-input").value;
        const referenceRange = row.querySelector(".range-input").value;

        results.push({
            name: testName,
            result: resultValue,
            unit: unit,
            range: referenceRange
        });
    });

    const report = {
        reportNumber: reportNumber,
        patientId: patientId,
        patient: patient,
        date: patient.date,
        doctor: patient.doctor,
        notes: patient.notes,
        results: results,
        status: "Final",
        createdAt: new Date().toISOString()
    };

    database.reports.push(report);
    database.settings.reportSequence++;

    saveDatabase();

    currentReport = report;

    showToast("تم حفظ التقرير بنجاح");

    updateCounters();
    renderRecentReports();
    renderHistory();
    renderStatistics();

    showReport(report);
});

