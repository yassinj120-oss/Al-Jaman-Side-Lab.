/* STATISTICS */
function renderStatistics(){
  document.getElementById("sPatients").textContent=data.patients.length;
  document.getElementById("sReports").textContent=data.reports.length;
  document.getElementById("sTests").textContent=data.reports.reduce((a,r)=>a+r.rows.length,0);

  const counts={};

  data.reports.forEach(r=>{
    r.rows.forEach(t=>{
      counts[t.name]=(counts[t.name]||0)+1;
    });
  });

  const sorted=Object.entries(counts).sort((a,b)=>b[1]-a[1]);

  document.getElementById("mostTests").innerHTML=sorted.map(x=>`
    <p>${escapeHTML(x[0])} — <b>${x[1]}</b></p>
  `).join("")||"لا توجد بيانات بعد";
}

/* DASHBOARD */
function renderDashboard(){
  document.getElementById("statPatients").textContent=data.patients.length;
  document.getElementById("statReports").textContent=data.reports.length;
  document.getElementById("statTests").textContent=data.reports.reduce((a,r)=>a+r.rows.length,0);
  document.getElementById("statToday").textContent=data.patients.filter(p=>p.date===today()).length;

  const recent=data.patients.slice(-5).reverse();

  document.getElementById("recentPatients").innerHTML=recent.map(p=>`
    <p>
      <b>${escapeHTML(p.name)}</b>
      <span class="badge">${p.id}</span>
      <small>${p.date}</small>
      <button class="primary" onclick="chooseTests('${p.id}')">تحاليل</button>
    </p>
  `).join("")||`<div class="empty">لا توجد بيانات بعد</div>`;
}

/* SETTINGS */
function saveSettings(){
  data.settings.labArabic=document.getElementById("labArabic").value;
  data.settings.labEnglish=document.getElementById("labEnglish").value;
  data.settings.labPhone=document.getElementById("labPhone").value;
  data.settings.labAddress=document.getElementById("labAddress").value;
  data.settings.authorized=document.getElementById("authorized").value;

  saveData();
  alert("تم حفظ الإعدادات");
}

/* BACKUP */
function backupData(){
  const blob=new Blob([JSON.stringify(data,null,2)],{type:"application/json"});
  const url=URL.createObjectURL(blob);

  const a=document.createElement("a");
  a.href=url;
  a.download="Al-Juman-Lab-Backup-"+today()+".json";
  a.click();

  URL.revokeObjectURL(url);

  data.backupDate=new Date().toLocaleString();
  saveData();
  document.getElementById("backupDate").textContent=data.backupDate;
}

function restoreData(event){
  const file=event.target.files[0];
  if(!file)return;

  const reader=new FileReader();

  reader.onload=function(){
    try{
      const restored=JSON.parse(reader.result);

      if(!restored.patients||!restored.reports||!restored.tests){
        alert("ملف النسخ الاحتياطي غير صحيح");
        return;
      }

      if(confirm("سيتم استبدال البيانات الحالية. هل أنت متأكد؟")){
        data=restored;
        saveData();
        renderAll();
        alert("تمت استعادة البيانات بنجاح");
      }
    }catch(e){
      alert("تعذر قراءة ملف النسخ الاحتياطي");
    }
  };

  reader.readAsText(file);
}

/* MODAL */
function openModal(title,content){
  document.getElementById("modalTitle").textContent=title;
  document.getElementById("modalBody").innerHTML=content;
  document.getElementById("modal").classList.remove("hidden");
}

function closeModal(){
  document.getElementById("modal").classList.add("hidden");
}

/* THEME */
function toggleTheme(){
  document.body.classList.toggle("dark");
  localStorage.setItem("aljuman_theme",
    document.body.classList.contains("dark")?"dark":"light");
}

/* RENDER */
function renderAll(){
  renderDashboard();
  renderPatients();
  renderTests();
  renderReports();
  renderStatistics();

  document.getElementById("labArabic").value=data.settings.labArabic||"";
  document.getElementById("labEnglish").value=data.settings.labEnglish||"";
  document.getElementById("labPhone").value=data.settings.labPhone||"";
  document.getElementById("labAddress").value=data.settings.labAddress||"";
  document.getElementById("authorized").value=data.settings.authorized||"";
  document.getElementById("backupDate").textContent=data.backupDate||"لم يتم إنشاء نسخة";
}

/* INITIALIZATION */
document.getElementById("today").textContent=
  new Date().toLocaleDateString("ar-IQ");

if(localStorage.getItem("aljuman_theme")==="dark"){
  document.body.classList.add("dark");
}

renderAll();
</script>

