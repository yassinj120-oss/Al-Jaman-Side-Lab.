/* =========================================
   INITIALIZATION
========================================= */

function initializeApp() {
    loadDatabase();

    if (!database.tests || database.tests.length === 0) {
        database.tests = [...defaultTests];
    }

    document.getElementById("analysisDate").value = todayDate();

    applyTheme();
    updateCounters();
    renderRecentReports();
    renderHistory();
    renderTestSelection();
    renderTestManagement();
    renderStatistics();
    generateNextIDs();

    document.getElementById("lockScreen").style.display = "flex";
}

function loadDatabase() {
    const saved = localStorage.getItem(STORAGE_KEY);

    if (saved) {
        try {
            database = JSON.parse(saved);

            if (!database.settings) {
                database.settings = {};
            }

            if (!database.tests) {
                database.tests = [...defaultTests];
            }

            if (!database.patients) {
                database.patients = [];
            }

            if (!database.reports) {
                database.reports = [];
            }

        } catch (error) {
            database = {
                patients: [],
                reports: [],
                tests: [...defaultTests],
                settings: {
                    arabicName: "مختبر الجمان الجانبي",
                    englishName: "Al-Juman Al-Janabi Laboratory",
                    phone: "07831216789",
                    address: "الصقلاوية - الشهداء الثانية",
                    password: "1234",
                    theme: "light",
                    patientSequence: 1,
                    reportSequence: 1
                }
            };
        }
    }
}

function saveDatabase() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(database));
}

function todayDate() {
    return new Date().toISOString().split("T")[0];
}

/* =========================================
   PASSWORD
========================================= */

function unlockApp() {
    const password = document.getElementById("lockPassword").value;

    if (password === database.settings.password) {
        document.getElementById("lockScreen").style.display = "none";
        document.getElementById("lockError").textContent = "";
        showToast("تم فتح التطبيق");
    } else {
        document.getElementById("lockError").textContent = "كلمة المرور غير صحيحة";
    }
}

function lockApp() {
    document.getElementById("lockPassword").value = "";
    document.getElementById("lockScreen").style.display = "flex";
}

function changePassword() {
    const newPassword = prompt("Enter the new password:");

    if (!newPassword || newPassword.length < 4) {
        alert("Password must contain at least 4 characters.");
        return;
    }

    database.settings.password = newPassword;
    saveDatabase();
