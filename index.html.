/* =========================================
   HISTORY
========================================= */

function renderHistory() {

    const search = document.getElementById("historySearch").value.toLowerCase();

    const table = document.getElementById("historyTable");

    const reports = [...database.reports].reverse().filter(report => {

        const patient = report.patient;

        const text = [
            report.reportNumber,
            report.patientId,
            patient.name,
            patient.gender,
            report.date
        ].join(" ").toLowerCase();

        return text.includes(search);
    });

    if (reports.length === 0) {
        table.innerHTML = `
            <tr>
                <td colspan="8" class="empty-state">لا توجد تقارير</td>
            </tr>
        `;
        return;
    }

    table.innerHTML = reports.map(report => {

        const patient = report.patient;

        return `
            <tr>
                <td>${escapeHTML(report.reportNumber)}</td>
                <td>${escapeHTML(report.patientId)}</td>
                <td>${escapeHTML(patient.name)}</td>
                <td>${escapeHTML(patient.age)} ${escapeHTML(patient.ageUnit)}</td>
                <td>${escapeHTML(patient.gender)}</td>
                <td>${escapeHTML(report.date)}</td>
                <td>${report.results.length}</td>
                <td>
                    <button class="primary" onclick="viewReport('${escapeAttribute(report.reportNumber)}')">عرض</button>
                    <button class="danger" onclick="deleteReport('${escapeAttribute(report.reportNumber)}')">حذف</button>
                </td>
            </tr>
        `;
    }).join("");
}

function deleteReport(reportNumber) {

    if (!confirm("هل تريد حذف هذا التقرير؟")) return;

    database.reports = database.reports.filter(report =>
        report.reportNumber !== reportNumber
    );

    saveDatabase();

    renderHistory();
    renderRecentReports();
    updateCounters();
    renderStatistics();

    showToast("تم حذف التقرير");
}

