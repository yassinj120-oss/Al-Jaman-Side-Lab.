function addNewTest() {

    const name = document.getElementById("newTestName").value.trim();

    if (!name) {
        alert("يرجى إدخال اسم التحليل");
        return;
    }

    if (database.tests.some(test => test.name.toLowerCase() === name.toLowerCase())) {
        alert("هذا التحليل موجود مسبقاً");
        return;
    }

    const test = {
        name: name,
        category: document.getElementById("newTestCategory").value,
        unit: document.getElementById("newTestUnit").value,
        male: document.getElementById("newTestMaleRange").value,
        female: document.getElementById("newTestFemaleRange").value,
        range: document.getElementById("newTestRange").value
    };

    database.tests.push(test);

    saveDatabase();

    document.getElementById("newTestName").value = "";
    document.getElementById("newTestUnit").value = "";
    document.getElementById("newTestMaleRange").value = "";
    document.getElementById("newTestFemaleRange").value = "";
    document.getElementById("newTestRange").value = "";

    renderTestManagement();
    renderTestSelection();

    showToast("تم إضافة التحليل");
}

function renderTestManagement() {

    const search = document.getElementById("manageTestSearch").value.toLowerCase();

    const table = document.getElementById("testsTable");

    const tests = database.tests.filter(test =>
        test.name.toLowerCase().includes(search) ||
        test.category.toLowerCase().includes(search)
    );

    table.innerHTML = tests.map(test => {

        const range = test.range || test.male || test.female || "";

        return `
            <tr>
                <td>${escapeHTML(test.name)}</td>
                <td>${escapeHTML(test.category)}</td>
                <td>${escapeHTML(test.unit || "")}</td>
                <td>${escapeHTML(range)}</td>
                <td>
                    <button class="danger"
                    onclick="deleteTest('${escapeAttribute(test.name)}')">
                    حذف
                    </button>
                </td>
            </tr>
        `;
    }).join("");
}

function deleteTest(testName) {

    if (!confirm("هل تريد حذف هذا التحليل من القائمة؟")) return;

    database.tests = database.tests.filter(test => test.name !== testName);

    selectedTests = selectedTests.filter(name => name !== testName);

    saveDatabase();

    renderTestManagement();
    renderTestSelection();

    showToast("تم حذف التحليل");
}

/* =========================================
   STATISTICS
========================================= */

function updateCounters() {

    document.getElementById("totalPatients").textContent = database.patients.length;

    document.getElementById("totalReports").textContent = database.reports.length;

    const testCount = database.reports.reduce((total,report) =>
        total + report.results.length, 0
    );

    document.getElementById("totalTests").textContent = testCount;

    const today = todayDate();

    const todayCount = database.reports.filter(report =>
        report.date === today
    ).length;

    document.getElementById("todayReports").textContent = todayCount;
}

function renderStatistics() {

    const testCount = database.reports.reduce((total,report) =>
        total + report.results.length, 0
    );

    const today = todayDate();

    const todayCount = database.reports.filter(report =>
        report.date === today
    ).length;

    document.getElementById("statsPatients").textContent = database.patients.length;
    document.getElementById("statsReports").textContent = database.reports.length;
    document.getElementById("statsTests").textContent = testCount;
    document.getElementById("statsToday").textContent = todayCount;

    const counts = {};

    database.reports.forEach(report => {
        report.results.forEach(result => {
            counts[result.name] = (counts[result.name] || 0) + 1;
        });
    });

    const sortedTests = Object.entries(counts).sort((a,b) => b[1]-a[1]);

    const container = document.getElementById("popularTests");

    if (sortedTests.length === 0) {
        container.innerHTML = "<div class='empty-state'>لا توجد بيانات بعد</div>";
        return;
    }

    container.innerHTML = `
        <table>
            <thead>
                <tr>
                    <th>Test Name</th>
                    <th>عدد مرات الطلب</th>
                </tr>
            </thead>
            <tbody>
                ${sortedTests.map(([name,count]) => `
                    <tr>
                        <td>${escapeHTML(name)}</td>
                        <td>${count}</td>
                    </tr>
                `).join("")}
            </tbody>
        </table>
    `;
}

