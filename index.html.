<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>مختبر الجمان الجانبي</title>

<style>
:root{
  --bg:#f3f6fb;
  --card:#ffffff;
  --text:#17243a;
  --muted:#718096;
  --primary:#153c67;
  --primary2:#2459c1;
  --border:#e3eaf2;
  --success:#239a61;
  --danger:#d94141;
  --warning:#e69a21;
}
.dark{
  --bg:#101827;
  --card:#1b2638;
  --text:#e9eef6;
  --muted:#a0aec0;
  --border:#334155;
}
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,Tahoma,sans-serif;
  background:var(--bg);
  color:var(--text);
}
button,input,select,textarea{
  font-family:inherit;
  font-size:14px;
}
button{
  cursor:pointer;
  border:0;
  border-radius:9px;
  padding:10px 14px;
}
.primary{
  background:var(--primary2);
  color:#fff;
}
.secondary{
  background:var(--border);
  color:var(--text);
}
.danger{
  background:var(--danger);
  color:white;
}
.success{
  background:var(--success);
  color:white;
}
.app{
  display:flex;
  min-height:100vh;
}
.sidebar{
  width:245px;
  background:var(--primary);
  color:#fff;
  padding:20px 14px;
  position:fixed;
  right:0;
  top:0;
  bottom:0;
  overflow:auto;
}
.brand{
  padding:15px 10px 25px;
  border-bottom:1px solid #ffffff30;
  margin-bottom:20px;
}
.brand h2{
  margin:0;
  font-size:20px;
}
.brand small{
  opacity:.75;
}
.nav button{
  display:block;
  width:100%;
  text-align:right;
  margin:5px 0;
  background:transparent;
  color:#fff;
  padding:13px;
  border-radius:9px;
}
.nav button:hover,
.nav button.active{
  background:#ffffff20;
}
.main{
  margin-right:245px;
  width:calc(100% - 245px);
  padding:22px;
}
.topbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
  gap:12px;
  margin-bottom:25px;
}
.card{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:14px;
  padding:18px;
  margin-bottom:18px;
  box-shadow:0 4px 12px rgba(0,0,0,.03);
}
.cards{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:15px;
}
.stat{
  border-right:4px solid var(--primary2);
}
.stat h3{
  color:var(--muted);
  margin:0 0 10px;
  font-size:14px;
}
.stat .number{
  font-size:28px;
  font-weight:bold;
}
h1,h2,h3{
  margin-top:0;
}
.section-title{
  margin:25px 0 15px;
}
.quick{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:12px;
}
.quick button{
  padding:20px 10px;
  background:var(--card);
  border:1px solid var(--border);
  color:var(--text);
  font-weight:bold;
}
input,select,textarea{
  width:100%;
  padding:11px;
  border:1px solid var(--border);
  border-radius:8px;
  background:var(--card);
  color:var(--text);
}
textarea{
  min-height:80px;
}
.form-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:14px;
}
.field label{
  display:block;
  margin-bottom:6px;
  font-weight:bold;
}
.table-wrap{
  overflow:auto;
}
table{
  width:100%;
  border-collapse:collapse;
  min-width:650px;
}
th,td{
  padding:12px;
  border-bottom:1px solid var(--border);
  text-align:right;
}
th{
  background:var(--bg);
}
.low{color:#2563eb;font-weight:bold}
.high{color:#dc2626;font-weight:bold}
.normal{color:#16a34a;font-weight:bold}
.hidden{display:none!important}
.actions{
  display:flex;
  gap:7px;
  flex-wrap:wrap;
}
.search{
  margin-bottom:15px;
}
.mobile-menu{
  display:none;
}
.modal{
  position:fixed;
  inset:0;
  background:#0008;
  display:flex;
  justify-content:center;
  align-items:center;
  padding:15px;
  z-index:100;
}
.modal-content{
  width:100%;
  max-width:650px;
  max-height:90vh;
  overflow:auto;
  background:var(--card);
  color:var(--text);
  padding:22px;
  border-radius:15px;
}
.modal-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
}
.footer-actions{
  display:flex;
  gap:10px;
  margin-top:20px;
  flex-wrap:wrap;
}
.badge{
  display:inline-block;
  padding:5px 9px;
  border-radius:20px;
  font-size:12px;
  background:var(--border);
}
.empty{
  text-align:center;
  padding:35px;
  color:var(--muted);
}
@media(max-width:900px){
  .sidebar{
    width:220px;
  }
  .main{
    margin-right:220px;
    width:calc(100% - 220px);
  }
  .cards{
    grid-template-columns:repeat(2,1fr);
  }
  .quick{
    grid-template-columns:repeat(2,1fr);
  }
}
@media(max-width:650px){
  .sidebar{
    position:relative;
    width:100%;
    height:auto;
    bottom:auto;
  }
  .app{
    display:block;
  }
  .main{
    margin:0;
    width:100%;
    padding:12px;
  }
  .nav{
    display:grid;
    grid-template-columns:repeat(2,1fr);
  }
  .brand{
    padding-bottom:12px;
  }
  .cards{
    grid-template-columns:repeat(2,1fr);
  }
  .form-grid{
    grid-template-columns:1fr;
  }
}
@media print{
  .sidebar,.topbar,.no-print{
    display:none!important;
  }
  .main{
    margin:0!important;
    width:100%!important;
    padding:0!important;
  }
  body{
    background:white;
    color:black;
  }
  .card{
    box-shadow:none;
    border:none;
  }
}
</style>
</head>

<body>

<div class="app">

<!-- SIDEBAR -->
<aside class="sidebar">
  <div class="brand">
    <h2>🏥 مختبر الجمان الجانبي</h2>
    <small>Al-Juman Al-Janabi Laboratory</small>
  </div>

  <div class="nav">
    <button class="active" onclick="showPage('dashboard',this)">🏠 الرئيسية</button>
    <button onclick="showPage('patients',this)">👥 سجل المرضى</button>
    <button onclick="showPage('tests',this)">🧪 إدارة التحاليل</button>
    <button onclick="showPage('reports',this)">📄 التقارير</button>
    <button onclick="showPage('statistics',this)">📊 الإحصائيات</button>
    <button onclick="showPage('backup',this)">💾 النسخ الاحتياطي</button>
    <button onclick="showPage('settings',this)">⚙️ الإعدادات</button>
  </div>
</aside>

<!-- MAIN -->
<main class="main">

<div class="topbar">
  <div>
    <h2 id="pageTitle">الرئيسية</h2>
    <small id="today"></small>
  </div>
  <div class="actions">
    <button class="secondary" onclick="toggleTheme()">🌙 / ☀️</button>
    <button class="primary" onclick="newPatient()">＋ مريض جديد</button>
  </div>
</div>

<!-- DASHBOARD -->
<section id="dashboard">

  <div class="cards">
    <div class="card stat">
      <h3>👥 إجمالي المرضى</h3>
      <div class="number" id="statPatients">0</div>
    </div>

    <div class="card stat">
      <h3>📄 إجمالي التقارير</h3>
      <div class="number" id="statReports">0</div>
    </div>

    <div class="card stat">
      <h3>🧪 التحاليل المسجلة</h3>
      <div class="number" id="statTests">0</div>
    </div>

    <div class="card stat">
      <h3>📅 مرضى اليوم</h3>
      <div class="number" id="statToday">0</div>
    </div>
  </div>

  <h3 class="section-title">الاختصارات السريعة</h3>

  <div class="quick">
    <button onclick="newPatient()">➕ مريض جديد</button>
    <button onclick="showPage('patients')">🔍 البحث عن مريض</button>
    <button onclick="showPage('tests')">🧪 التحاليل</button>
    <button onclick="showPage('statistics')">📊 الإحصائيات</button>
  </div>

  <div class="card" style="margin-top:20px">
    <h3>آخر المرضى</h3>
    <div id="recentPatients"></div>
  </div>
</section>

<!-- PATIENTS -->
<section id="patients" class="hidden">
  <div class="card">
    <div class="actions">
      <button class="primary" onclick="newPatient()">＋ تسجيل مريض جديد</button>
    </div>

    <input class="search" id="patientSearch"
      placeholder="بحث بالاسم أو رقم المريض أو التقرير..."
      oninput="renderPatients()">

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Patient ID</th>
            <th>الاسم</th>
            <th>العمر</th>
            <th>الجنس</th>
            <th>التاريخ</th>
            <th>الإجراءات</th>
          </tr>
        </thead>
        <tbody id="patientTable"></tbody>
      </table>
    </div>
  </div>
</section>

<!-- TESTS -->
<section id="tests" class="hidden">
  <div class="card">
    <div class="actions">
      <button class="primary" onclick="addTest()">＋ إضافة تحليل</button>
    </div>

    <input class="search" id="testSearch"
      placeholder="بحث عن تحليل..."
      oninput="renderTests()">

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Test Name</th>
            <th>Category</th>
            <th>Unit</th>
            <th>Male Range</th>
            <th>Female Range</th>
            <th>الإجراءات</th>
          </tr>
        </thead>
        <tbody id="testTable"></tbody>
      </table>
    </div>
  </div>
</section>

<!-- REPORTS -->
<section id="reports" class="hidden">
  <div class="card">
    <h3>التقارير</h3>

    <input class="search" id="reportSearch"
      placeholder="بحث بالاسم أو رقم التقرير..."
      oninput="renderReports()">

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Report Number</th>
            <th>Patient</th>
            <th>Date</th>
            <th>Tests</th>
            <th>الإجراءات</th>
          </tr>
        </thead>
        <tbody id="reportTable"></tbody>
      </table>
    </div>
  </div>
</section>

<!-- STATISTICS -->
<section id="statistics" class="hidden">
  <div class="cards">
    <div class="card stat">
      <h3>إجمالي المرضى</h3>
      <div class="number" id="sPatients">0</div>
    </div>
    <div class="card stat">
      <h3>إجمالي التقارير</h3>
      <div class="number" id="sReports">0</div>
    </div>
    <div class="card stat">
      <h3>إجمالي التحاليل</h3>
      <div class="number" id="sTests">0</div>
    </div>
  </div>

  <div class="card">
    <h3>التحاليل الأكثر استخداماً</h3>
    <div id="mostTests"></div>
  </div>
</section>

<!-- BACKUP -->
<section id="backup" class="hidden">
  <div class="card">
    <h3>النسخ الاحتياطي والاستعادة</h3>
    <p>يمكنك تنزيل نسخة تحتوي على بيانات المرضى والتحاليل والتقارير والإعدادات.</p>

    <div class="footer-actions">
      <button class="primary" onclick="backupData()">⬇️ تنزيل نسخة احتياطية</button>
      <button class="secondary" onclick="document.getElementById('restoreFile').click()">⬆️ استعادة نسخة</button>
    </div>

    <input type="file" id="restoreFile" accept=".json"
      class="hidden" onchange="restoreData(event)">

    <hr>

    <p>آخر نسخة احتياطية: <span id="backupDate">لم يتم إنشاء نسخة</span></p>
  </div>
</section>

<!-- SETTINGS -->
<section id="settings" class="hidden">
  <div class="card">
    <h3>معلومات المختبر</h3>

    <div class="form-grid">
      <div class="field">
        <label>اسم المختبر بالعربي</label>
        <input id="labArabic" value="مختبر الجمان الجانبي">
      </div>

      <div class="field">
        <label>Laboratory Name</label>
        <input id="labEnglish" value="Al-Juman Al-Janabi Laboratory">
      </div>

      <div class="field">
        <label>رقم الهاتف</label>
        <input id="labPhone" value="07831216789">
      </div>

      <div class="field">
        <label>العنوان</label>
        <input id="labAddress" value="الصقلاوية - الشهداء الثانية">
      </div>

      <div class="field">
        <label>اسم الشخص المخول</label>
        <input id="authorized">
      </div>
    </div>

    <div class="footer-actions">
      <button class="primary" onclick="saveSettings()">💾 حفظ الإعدادات</button>
    </div>
  </div>
</section>

</main>
</div>

<!-- MODAL -->
<div id="modal" class="modal hidden">
  <div class="modal-content">
    <div class="modal-header">
      <h3 id="modalTitle"></h3>
      <button class="secondary" onclick="closeModal()">✕</button>
    </div>
    <div id="modalBody"></div>
  </div>
</div>

<script>
/* STORAGE */
const STORAGE_KEY = "aljuman_lab_v1";

let data = JSON.parse(localStorage.getItem(STORAGE_KEY) || "null");

if(!data){
  data={
    patients:[],
    reports:[],
    tests:[
      {name:"CBC",category:"Hematology",unit:"",male:"",female:""},
      {name:"Hemoglobin",category:"Hematology",unit:"g/dL",male:"13.0 - 17.0",female:"12.0 - 15.0"},
      {name:"WBC",category:"Hematology",unit:"10³/µL",male:"4 - 11",female:"4 - 11"},
      {name:"Platelets",category:"Hematology",unit:"10³/µL",male:"150 - 450",female:"150 - 450"},
      {name:"ESR",category:"Hematology",unit:"mm/hr",male:"0 - 15",female:"0 - 20"},
      {name:"Glucose",category:"Biochemistry",unit:"mg/dL",male:"70 - 110",female:"70 - 110"},
      {name:"Urea",category:"Biochemistry",unit:"mg/dL",male:"15 - 45",female:"15 - 45"},
      {name:"Creatinine",category:"Biochemistry",unit:"mg/dL",male:"0.7 - 1.3",female:"0.6 - 1.1"},
      {name:"ALT",category:"Biochemistry",unit:"U/L",male:"0 - 45",female:"0 - 35"},
      {name:"AST",category:"Biochemistry",unit:"U/L",male:"0 - 40",female:"0 - 35"},
      {name:"Cholesterol",category:"Biochemistry",unit:"mg/dL",male:"< 200",female:"< 200"},
      {name:"Triglycerides",category:"Biochemistry",unit:"mg/dL",male:"< 150",female:"< 150"},
      {name:"HDL",category:"Biochemistry",unit:"mg/dL",male:"> 40",female:"> 50"},
      {name:"LDL",category:"Biochemistry",unit:"mg/dL",male:"< 100",female:"< 100"},
      {name:"TSH",category:"Hormones",unit:"µIU/mL",male:"0.4 - 4",female:"0.4 - 4"},
      {name:"T3",category:"Hormones",unit:"ng/mL",male:"",female:""},
      {name:"T4",category:"Hormones",unit:"µg/dL",male:"",female:""},
      {name:"Vitamin D",category:"Biochemistry",unit:"ng/mL",male:"30 - 100",female:"30 - 100"},
      {name:"CRP",category:"Immunology",unit:"mg/L",male:"< 5",female:"< 5"},
      {name:"ASO",category:"Immunology",unit:"IU/mL",male:"< 200",female:"< 200"},
      {name:"RF",category:"Immunology",unit:"IU/mL",male:"< 14",female:"< 14"},
      {name:"Urine Analysis",category:"Urine",unit:"",male:"",female:""},
      {name:"Troponin I",category:"Cardiac",unit:"ng/mL",male:"",female:""},
      {name:"NT-proBNP",category:"Cardiac",unit:"pg/mL",male:"",female:""}
    ],
    settings:{
      labArabic:"مختبر الجمان الجانبي",
      labEnglish:"Al-Juman Al-Janabi Laboratory",
      labPhone:"07831216789",
      labAddress:"الصقلاوية - الشهداء الثانية",
      authorized:""
    },
    backupDate:""
  };
  saveData();
}

/* UTILITIES */
function saveData(){
  localStorage.setItem(STORAGE_KEY,JSON.stringify(data));
}

function today(){
  return new Date().toISOString().slice(0,10);
}

function nextPatientID(){
  return "P-" + String(data.patients.length+1).padStart(5,"0");
}

function nextReportID(){
  return "R-" + String(data.reports.length+1).padStart(5,"0");
}

function escapeHTML(s){
  return String(s ?? "")
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;");
}

/* NAVIGATION */
function showPage(page,button){
  document.querySelectorAll("main section").forEach(s=>s.classList.add("hidden"));
  document.getElementById(page).classList.remove("hidden");

  document.querySelectorAll(".nav button").forEach(b=>b.classList.remove("active"));
  if(button) button.classList.add("active");

  const titles={
    dashboard:"الرئيسية",
    patients:"سجل المرضى",
    tests:"إدارة التحاليل",
    reports:"التقارير",
    statistics:"الإحصائيات",
    backup:"النسخ الاحتياطي",
    settings:"الإعدادات"
  };

  document.getElementById("pageTitle").textContent=titles[page]||page;

  renderAll();
}

/* PATIENTS */
function newPatient(){
  openModal("تسجيل مريض جديد",`
    <form id="patientForm">
      <div class="form-grid">

        <div class="field">
          <label>Full Name *</label>
          <input name="name" required>
        </div>

        <div class="field">
          <label>Patient ID</label>
          <input value="${nextPatientID()}" readonly>
        </div>

        <div class="field">
          <label>Age *</label>
          <input name="age" type="number" min="0" required>
        </div>

        <div class="field">
          <label>Age Unit *</label>
          <select name="ageUnit">
            <option>Years</option>
            <option>Months</option>
            <option>Days</option>
          </select>
        </div>

        <div class="field">
          <label>Gender *</label>
          <select name="gender" required>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
          </select>
        </div>

        <div class="field">
          <label>Analysis Date *</label>
          <input name="date" type="date" value="${today()}" required>
        </div>

        <div class="field">
          <label>Doctor Name</label>
          <input name="doctor">
        </div>

        <div class="field">
          <label>Notes</label>
          <input name="notes">
        </div>

      </div>

      <div class="footer-actions">
        <button class="primary" type="submit">حفظ واختيار التحاليل</button>
      </div>
    </form>
  `);

  document.getElementById("patientForm").onsubmit=function(e){
    e.preventDefault();
    const f=new FormData(e.target);

    const patient={
      id:nextPatientID(),
      name:f.get("name"),
      age:f.get("age"),
      ageUnit:f.get("ageUnit"),
      gender:f.get("gender"),
      date:f.get("date"),
      doctor:f.get("doctor"),
      notes:f.get("notes")
    };

    data.patients.push(patient);
    saveData();
    closeModal();
    chooseTests(patient.id);
  };
}

function renderPatients(){
  const q=(document.getElementById("patientSearch")?.value||"").toLowerCase();

  const rows=data.patients.filter(p=>
    p.name.toLowerCase().includes(q)||
    p.id.toLowerCase().includes(q)
  );

  document.getElementById("patientTable").innerHTML=rows.map(p=>`
    <tr>
      <td>${escapeHTML(p.id)}</td>
      <td>${escapeHTML(p.name)}</td>
      <td>${p.age} ${p.ageUnit}</td>
      <td>${p.gender}</td>
      <td>${p.date}</td>
      <td>
        <div class="actions">
          <button class="primary" onclick="chooseTests('${p.id}')">تحاليل</button>
          <button class="secondary" onclick="patientReports('${p.id}')">تقارير</button>
        </div>
      </td>
    </tr>
  `).join("") || `<tr><td colspan="6" class="empty">لا يوجد مرضى</td></tr>`;
}

/* TEST MANAGEMENT */
function renderTests(){
  const q=(document.getElementById("testSearch")?.value||"").toLowerCase();

  const list=data.tests.filter(t=>
    t.name.toLowerCase().includes(q)||
    t.category.toLowerCase().includes(q)
  );

  document.getElementById("testTable").innerHTML=list.map(t=>`
    <tr>
      <td>${escapeHTML(t.name)}</td>
      <td>${escapeHTML(t.category)}</td>
      <td>${escapeHTML(t.unit)}</td>
      <td>${escapeHTML(t.male)}</td>
      <td>${escapeHTML(t.female)}</td>
      <td>
        <button class="secondary" onclick="editTest('${encodeURIComponent(t.name)}')">تعديل</button>
        <button class="danger" onclick="deleteTest('${encodeURIComponent(t.name)}')">حذف</button>
      </td>
    </tr>
  `).join("") || `<tr><td colspan="6" class="empty">لا توجد تحاليل</td></tr>`;
}

function addTest(){
  testForm();
}

function editTest(encodedName){
  const name=decodeURIComponent(encodedName);
  const t=data.tests.find(x=>x.name===name);
  if(t)testForm(t);
}

function testForm(test=null){
  openModal(test?"تعديل التحليل":"إضافة تحليل جديد",`
    <form id="testForm">
      <div class="form-grid">
        <div class="field">
          <label>Test Name</label>
          <input name="name" required value="${escapeHTML(test?.name||"")}">
        </div>

        <div class="field">
          <label>Category</label>
          <input name="category" value="${escapeHTML(test?.category||"Other")}">
        </div>

        <div class="field">
          <label>Unit</label>
          <input name="unit" value="${escapeHTML(test?.unit||"")}">
        </div>

        <div class="field">
          <label>Male Reference Range</label>
          <input name="male" value="${escapeHTML(test?.male||"")}">
        </div>

        <div class="field">
          <label>Female Reference Range</label>
          <input name="female" value="${escapeHTML(test?.female||"")}">
        </div>
      </div>

      <div class="footer-actions">
        <button class="primary" type="submit">حفظ</button>
      </div>
    </form>
  `);

  document.getElementById("testForm").onsubmit=function(e){
    e.preventDefault();
    const f=new FormData(e.target);
    const obj={
      name:f.get("name"),
      category:f.get("category"),
      unit:f.get("unit"),
      male:f.get("male"),
      female:f.get("female")
    };

    if(test){
      const index=data.tests.findIndex(x=>x.name===test.name);
      if(index>=0)data.tests[index]=obj;
    }else{
      data.tests.push(obj);
    }

    saveData();
    closeModal();
    renderAll();
  };
}

function deleteTest(encodedName){
  const name=decodeURIComponent(encodedName);
  if(!confirm("هل تريد حذف التحليل "+name+"؟"))return;
  data.tests=data.tests.filter(t=>t.name!==name);
  saveData();
  renderAll();
}

/* SELECT TESTS */
function chooseTests(patientID){
  const p=data.patients.find(x=>x.id===patientID);
  if(!p)return;

  openModal("اختيار التحاليل للمريض",`
    <p><b>${escapeHTML(p.name)}</b></p>
    <input id="testPickerSearch" placeholder="بحث عن تحليل..." oninput="filterPicker()">

    <div id="testPicker" style="max-height:300px;overflow:auto;margin-top:10px">
      ${data.tests.map(t=>`
        <label style="display:flex;align-items:center;gap:10px;padding:9px;border-bottom:1px solid var(--border)">
          <input type="checkbox" value="${escapeHTML(t.name)}" style="width:auto">
          <span>${escapeHTML(t.name)} <small>(${escapeHTML(t.category)})</small></span>
        </label>
      `).join("")}
    </div>

    <div class="footer-actions">
      <button class="primary" onclick="startResults('${patientID}')">إدخال النتائج</button>
    </div>
  `);
}

function filterPicker(){
  const q=document.getElementById("testPickerSearch").value.toLowerCase();
  document.querySelectorAll("#testPicker label").forEach(label=>{
    label.style.display=label.textContent.toLowerCase().includes(q)?"flex":"none";
  });
}

/* RESULTS */
function startResults(patientID){
  const p=data.patients.find(x=>x.id===patientID);
  const selected=[...document.querySelectorAll("#testPicker input:checked")].map(x=>x.value);

  if(selected.length===0){
    alert("اختار تحليل واحد على الأقل");
    return;
  }

  closeModal();
  resultForm(p,selected);
}

function resultForm(patient,selected){
  const reportID=nextReportID();

  const rows=selected.map(name=>{
    const t=data.tests.find(x=>x.name===name);
    const ref=patient.gender==="Male"?t.male:t.female;

    return{
      name:t.name,
      result:"",
      unit:t.unit,
      reference:ref,
      category:t.category,
      note:""
    };
  });

  openModal("إدخال نتائج التحاليل",`
    <div>
      <h3>${escapeHTML(patient.name)}</h3>
      <p>Patient ID: ${patient.id} | Report: ${reportID}</p>
      <p>${patient.age} ${patient.ageUnit} | ${patient.gender}</p>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Test</th>
              <th>Result</th>
              <th>Unit</th>
              <th>Reference</th>
            </tr>
          </thead>
          <tbody id="resultRows">
            ${rows.map((r,i)=>`
              <tr>
                <td>${escapeHTML(r.name)}</td>
                <td><input id="res${i}" placeholder="Result"></td>
                <td><input id="unit${i}" value="${escapeHTML(r.unit)}"></td>
                <td><input id="ref${i}" value="${escapeHTML(r.reference)}"></td>
              </tr>
            `).join("")}
          </tbody>
        </table>
      </div>

      <div class="field" style="margin-top:15px">
        <label>Report Notes</label>
        <textarea id="reportNotes"></textarea>
      </div>

      <div class="footer-actions">
        <button class="primary" onclick="saveReport('${patient.id}','${reportID}',${JSON.stringify(rows).replace(/"/g,'&quot;')})">حفظ التقرير</button>
      </div>
    </div>
  `);
}

/* Save report */
function saveReport(patientID,reportID,rowsJSON){
  const p=data.patients.find(x=>x.id===patientID);
  const rows=JSON.parse(decodeHTML(rowsJSON));

  rows.forEach((r,i)=>{
    r.result=document.getElementById("res"+i).value;
    r.unit=document.getElementById("unit"+i).value;
    r.reference=document.getElementById("ref"+i).value;
  });

  const report={
    id:reportID,
    patientID:patientID,
    date:today(),
    rows:rows,
    notes:document.getElementById("reportNotes").value,
    status:"Final"
  };

  data.reports.push(report);
  saveData();
  closeModal();
  renderAll();

  alert("تم حفظ التقرير بنجاح");
  viewReport(reportID);
}

function decodeHTML(value){
  const div=document.createElement("div");
  div.innerHTML=value;
  return div.textContent;
}

/* REPORTS */
function renderReports(){
  const q=(document.getElementById("reportSearch")?.value||"").toLowerCase();

  const list=data.reports.filter(r=>{
    const p=data.patients.find(x=>x.id===r.patientID);
    return r.id.toLowerCase().includes(q)||(p?.name||"").toLowerCase().includes(q);
  });

  document.getElementById("reportTable").innerHTML=list.map(r=>{
    const p=data.patients.find(x=>x.id===r.patientID);
    return`
      <tr>
        <td>${r.id}</td>
        <td>${escapeHTML(p?.name||"")}</td>
        <td>${r.date}</td>
        <td>${r.rows.length}</td>
        <td>
          <button class="primary" onclick="viewReport('${r.id}')">عرض</button>
          <button class="secondary" onclick="printReport('${r.id}')">طباعة</button>
        </td>
      </tr>
    `;
  }).join("")||`<tr><td colspan="5" class="empty">لا توجد تقارير</td></tr>`;
}

function patientReports(patientID){
  showPage("reports");
  document.getElementById("reportSearch").value=patientID;
  renderReports();
}

function viewReport(reportID){
  const r=data.reports.find(x=>x.id===reportID);
  if(!r)return;

  const p=data.patients.find(x=>x.id===r.patientID);

  openModal("عرض التقرير",`
    <div id="reportPreview">
      <div style="text-align:center;border-bottom:2px solid #153c67;padding-bottom:15px">
        <h2>${escapeHTML(data.settings.labArabic)}</h2>
        <h3>${escapeHTML(data.settings.labEnglish)}</h3>
        <p>${escapeHTML(data.settings.labAddress)}</p>
        <p>${escapeHTML(data.settings.labPhone)}</p>
      </div>

      <h3 style="text-align:center;margin-top:20px">LABORATORY REPORT</h3>

      <div class="form-grid">
        <p><b>Patient:</b> ${escapeHTML(p.name)}</p>
        <p><b>Patient ID:</b> ${p.id}</p>
        <p><b>Age:</b> ${p.age} ${p.ageUnit}</p>
        <p><b>Gender:</b> ${p.gender}</p>
        <p><b>Report No:</b> ${r.id}</p>
        <p><b>Date:</b> ${r.date}</p>
      </div>

      <table>
        <thead>
          <tr>
            <th>Test Name</th>
            <th>Result</th>
            <th>Unit</th>
            <th>Reference Range</th>
          </tr>
        </thead>
        <tbody>
          ${r.rows.map(x=>`
            <tr>
              <td>${escapeHTML(x.name)}</td>
              <td><b>${escapeHTML(x.result)}</b></td>
              <td>${escapeHTML(x.unit)}</td>
              <td>${escapeHTML(x.reference)}</td>
            </tr>
          `).join("")}
        </tbody>
      </table>

      <p><b>Notes:</b> ${escapeHTML(r.notes)}</p>

      <div style="margin-top:50px">
        <b>Authorized Person:</b> ${escapeHTML(data.settings.authorized)}
      </div>
    </div>

    <div class="footer-actions no-print">
      <button class="primary" onclick="printReport('${r.id}')">🖨️ طباعة / PDF</button>
    </div>
  `);
}

function printReport(reportID){
  const r=data.reports.find(x=>x.id===reportID);
  const p=data.patients.find(x=>x.id===r.patientID);

  const w=window.open("","_blank");

  w.document.write(`
    <!DOCTYPE html>
    <html lang="en">
    <head>
      <meta charset="UTF-8">
      <title>Laboratory Report</title>
      <style>
        body{font-family:Arial;padding:30px;color:#111}
        table{width:100%;border-collapse:collapse;margin-top:20px}
        th,td{border:1px solid #555;padding:10px;text-align:left}
        th{background:#eee}
        .header{text-align:center;border-bottom:2px solid #153c67;padding-bottom:15px}
        .info{display:grid;grid-template-columns:1fr 1fr;margin-top:20px}
        @media print{button{display:none}}
      </style>
    </head>
    <body>
      <div class="header">
        <h2>${escapeHTML(data.settings.labArabic)}</h2>
        <h3>${escapeHTML(data.settings.labEnglish)}</h3>
        <p>${escapeHTML(data.settings.labAddress)}</p>
        <p>${escapeHTML(data.settings.labPhone)}</p>
      </div>

      <h2 style="text-align:center">LABORATORY REPORT</h2>

      <div class="info">
        <p><b>Patient:</b> ${escapeHTML(p.name)}</p>
        <p><b>Patient ID:</b> ${p.id}</p>
        <p><b>Age:</b> ${p.age} ${p.ageUnit}</p>
        <p><b>Gender:</b> ${p.gender}</p>
        <p><b>Report No:</b> ${r.id}</p>
        <p><b>Date:</b> ${r.date}</p>
      </div>

      <table>
        <thead>
          <tr>
            <th>Test Name</th>
            <th>Result</th>
            <th>Unit</th>
            <th>Reference Range</th>
          </tr>
        </thead>
        <tbody>
          ${r.rows.map(x=>`
            <tr>
              <td>${escapeHTML(x.name)}</td>
              <td><b>${escapeHTML(x.result)}</b></td>
              <td>${escapeHTML(x.unit)}</td>
              <td>${escapeHTML(x.reference)}</td>
            </tr>
          `).join("")}
        </tbody>
      </table>

      <p><b>Notes:</b> ${escapeHTML(r.notes)}</p>

      <br><br>
      <p><b>Authorized Person:</b> ${escapeHTML(data.settings.authorized)}</p>

      <script>
        window.onload=function(){window.print();}
      <\/script>
    </body>
    </html>
  `);

  w.document.close();
}

/* STATISTICS */
function renderStatistics(){
  document.getElementById("sPatients").textContent=data.patients.length;
  document.getElementById("sReports").textContent=data.reports.length;
  document.getElementById("sTests").textContent=data.reports.reduce((a,r)=>a+r.rows.length,0);

  const counts={};

  data.reports.forEach(r=>{
    r.rows.forEach(t=>{
      counts[t.name]=(counts[t.name]||0)+1;
    });
  });

  const sorted=Object.entries(counts).sort((a,b)=>b[1]-a[1]);

  document.getElementById("mostTests").innerHTML=sorted.map(x=>`
    <p>${escapeHTML(x[0])} — <b>${x[1]}</b></p>
  `).join("")||"لا توجد بيانات بعد";
}

/* DASHBOARD */
function renderDashboard(){
  document.getElementById("statPatients").textContent=data.patients.length;
  document.getElementById("statReports").textContent=data.reports.length;
  document.getElementById("statTests").textContent=data.reports.reduce((a,r)=>a+r.rows.length,0);
  document.getElementById("statToday").textContent=data.patients.filter(p=>p.date===today()).length;

  const recent=data.patients.slice(-5).reverse();

  document.getElementById("recentPatients").innerHTML=recent.map(p=>`
    <p>
      <b>${escapeHTML(p.name)}</b>
      <span class="badge">${p.id}</span>
      <small>${p.date}</small>
      <button class="primary" onclick="chooseTests('${p.id}')">تحاليل</button>
    </p>
  `).join("")||`<div class="empty">لا توجد بيانات بعد</div>`;
}

/* SETTINGS */
function saveSettings(){
  data.settings.labArabic=document.getElementById("labArabic").value;
  data.settings.labEnglish=document.getElementById("labEnglish").value;
  data.settings.labPhone=document.getElementById("labPhone").value;
  data.settings.labAddress=document.getElementById("labAddress").value;
  data.settings.authorized=document.getElementById("authorized").value;

  saveData();
  alert("تم حفظ الإعدادات");
}

/* BACKUP */
function backupData(){
  const blob=new Blob([JSON.stringify(data,null,2)],{type:"application/json"});
  const url=URL.createObjectURL(blob);

  const a=document.createElement("a");
  a.href=url;
  a.download="Al-Juman-Lab-Backup-"+today()+".json";
  a.click();

  URL.revokeObjectURL(url);

  data.backupDate=new Date().toLocaleString();
  saveData();
  document.getElementById("backupDate").textContent=data.backupDate;
}

function restoreData(event){
  const file=event.target.files[0];
  if(!file)return;

  const reader=new FileReader();

  reader.onload=function(){
    try{
      const restored=JSON.parse(reader.result);

      if(!restored.patients||!restored.reports||!restored.tests){
        alert("ملف النسخ الاحتياطي غير صحيح");
        return;
      }

      if(confirm("سيتم استبدال البيانات الحالية. هل أنت متأكد؟")){
        data=restored;
        saveData();
        renderAll();
        alert("تمت استعادة البيانات بنجاح");
      }
    }catch(e){
      alert("تعذر قراءة ملف النسخ الاحتياطي");
    }
  };

  reader.readAsText(file);
}

/* MODAL */
function openModal(title,content){
  document.getElementById("modalTitle").textContent=title;
  document.getElementById("modalBody").innerHTML=content;
  document.getElementById("modal").classList.remove("hidden");
}

function closeModal(){
  document.getElementById("modal").classList.add("hidden");
}

/* THEME */
function toggleTheme(){
  document.body.classList.toggle("dark");
  localStorage.setItem("aljuman_theme",
    document.body.classList.contains("dark")?"dark":"light");
}

/* RENDER */
function renderAll(){
  renderDashboard();
  renderPatients();
  renderTests();
  renderReports();
  renderStatistics();

  document.getElementById("labArabic").value=data.settings.labArabic||"";
  document.getElementById("labEnglish").value=data.settings.labEnglish||"";
  document.getElementById("labPhone").value=data.settings.labPhone||"";
  document.getElementById("labAddress").value=data.settings.labAddress||"";
  document.getElementById("authorized").value=data.settings.authorized||"";
  document.getElementById("backupDate").textContent=data.backupDate||"لم يتم إنشاء نسخة";
}

/* INITIALIZATION */
document.getElementById("today").textContent=
  new Date().toLocaleDateString("ar-IQ");

if(localStorage.getItem("aljuman_theme")==="dark"){
  document.body.classList.add("dark");
}

renderAll();
</script>

</body>
