<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Al-Juman Al-Janabi Laboratory</title>

<style>
:root {
    --bg: #f3f6fb;
    --card: #ffffff;
    --text: #17243a;
    --muted: #718096;
    --primary: #153c67;
    --primary2: #245c91;
    --accent: #24a1a9;
    --border: #e3eaf2;
    --success: #239a61;
    --danger: #d94141;
    --warning: #e69a21;
    --shadow: 0 4px 20px rgba(22,47,79,.08);
}

.dark {
    --bg: #101827;
    --card: #1b2638;
    --text: #e9eef6;
    --muted: #a0aec0;
    --primary: #1e426d;
    --primary2: #3274b7;
    --accent: #39b5bd;
    --border: #334155;
    --shadow: 0 4px 20px rgba(0,0,0,.2);
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, Tahoma, sans-serif;
    background: var(--bg);
    color: var(--text);
}

button, input, select, textarea {
    font-family: inherit;
    font-size: 14px;
}

button {
    cursor: pointer;
    border: none;
    border-radius: 9px;
    padding: 10px 15px;
    transition: .2s;
}

button:hover {
    opacity: .9;
}

.primary {
    background: var(--primary2);
    color: white;
}

.secondary {
    background: var(--border);
    color: var(--text);
}

.danger {
    background: var(--danger);
    color: white;
}

.success {
    background: var(--success);
    color: white;
}

.app {
    display: flex;
    min-height: 100vh;
}

.sidebar {
    width: 250px;
    background: var(--primary);
    color: white;
    padding: 20px 15px;
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    overflow-y: auto;
    z-index: 100;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 25px;
    padding: 10px;
}

.logo {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: white;
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 24px;
}

.brand h2 {
    font-size: 16px;
    margin: 0;
}

.brand small {
    opacity: .75;
}

.nav-button {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    text-align: right;
    background: transparent;
    color: white;
    margin: 4px 0;
    padding: 12px;
    border-radius: 9px;
}

.nav-button:hover,
.nav-button.active {
    background: rgba(255,255,255,.15);
}

.nav-button span {
    font-size: 18px;
}

.sidebar-footer {
    margin-top: 30px;
    border-top: 1px solid rgba(255,255,255,.2);
    padding-top: 15px;
}

.main {
    flex: 1;
    margin-right: 250px;
    min-width: 0;
}

.topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 25px;
    background: var(--card);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 20;
}

.topbar h1 {
    font-size: 22px;
    margin: 0;
}

.topbar-actions {
    display: flex;
    gap: 8px;
    align-items: center;
}

.content {
    padding: 25px;
}

.page {
    display: none;
}

.page.active {
    display: block;
}

.cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0,1fr));
    gap: 16px;
    margin-bottom: 25px;
}

.stat-card {
    background: var(--card);
    padding: 20px;
    border-radius: 14px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
}

.stat-card .icon {
    font-size: 26px;
}

.stat-card h3 {
    margin: 15px 0 5px;
    font-size: 27px;
}

.stat-card p {
    color: var(--muted);
    margin: 0;
}

.panel {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px;
    margin-bottom: 20px;
    box-shadow: var(--shadow);
}

.panel h2 {
    margin-top: 0;
    font-size: 19px;
}

.quick-actions {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
}

.quick-action {
    padding: 18px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--text);
    text-align: center;
}

.quick-action .icon {
    font-size: 25px;
    display: block;
    margin-bottom: 8px;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
}

.form-group {
    margin-bottom: 14px;
}

.form-group.full {
    grid-column: 1 / -1;
}

label {
    display: block;
    margin-bottom: 7px;
    font-weight: bold;
    font-size: 13px;
}

input, select, textarea {
    width: 100%;
    padding: 11px;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
    outline: none;
}

input:focus, select:focus, textarea:focus {
    border-color: var(--primary2);
}

textarea {
    resize: vertical;
    min-height: 80px;
}

.form-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 15px;
}

.search-box {
    margin-bottom: 15px;
}

.table-wrap {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    min-width: 650px;
}

th, td {
    padding: 12px;
    text-align: right;
    border-bottom: 1px solid var(--border);
}

th {
    background: var(--bg);
    font-size: 13px;
}

td {
    font-size: 14px;
}

.badge {
    padding: 5px 9px;
    border-radius: 20px;
    font-size: 12px;
    display: inline-block;
}

.badge-draft {
    background: #fff4d5;
    color: #8b6300;
}

.badge-final {
    background: #dff5e8;
    color: #167244;
}

.test-category {
    margin-top: 15px;
    padding: 12px;
    background: var(--bg);
    border-radius: 10px;
}

.test-category h3 {
    margin: 0 0 10px;
}

.test-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
}

.test-option {
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 8px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
}

.test-option input {
    width: auto;
}

.result-row {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 8px;
    align-items: center;
    margin-bottom: 8px;
}

.result-row input {
    padding: 9px;
}

.result-row small {
    color: var(--muted);
}

.empty-state {
    text-align: center;
    padding: 35px;
    color: var(--muted);
}

.hidden {
    display: none !important;
}

.toast {
    position: fixed;
    left: 20px;
    bottom: 20px;
    background: var(--success);
    color: white;
    padding: 15px 20px;
    border-radius: 10px;
    z-index: 9999;
    display: none;
}

.modal {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.55);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 15px;
}

.modal-content {
    width: 100%;
    max-width: 700px;
    max-height: 90vh;
    overflow: auto;
    background: var(--card);
    color: var(--text);
    padding: 25px;
    border-radius: 15px;
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.modal-header h2 {
    margin: 0;
}

.close-btn {
    background: var(--border);
    color: var(--text);
    font-size: 20px;
}

.settings-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
}

.mobile-menu {
    display: none;
}

#lockScreen {
    position: fixed;
    inset: 0;
    background: var(--primary);
    color: white;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.lock-box {
    background: var(--card);
    color: var(--text);
    padding: 30px;
    border-radius: 18px;
    max-width: 400px;
    width: 100%;
    text-align: center;
}

.lock-box input {
    margin: 15px 0;
    text-align: center;
}

@media(max-width:1100px) {
    .cards {
        grid-template-columns: repeat(2,1fr);
    }

    .quick-actions {
        grid-template-columns: repeat(2,1fr);
    }
}

@media(max-width:750px) {
    .sidebar {
        transform: translateX(100%);
        transition: .25s;
    }

    .sidebar.open {
        transform: translateX(0);
    }

    .main {
        margin-right: 0;
    }

    .mobile-menu {
        display: block;
    }

    .topbar {
        padding: 15px;
    }

    .content {
        padding: 15px;
    }

    .cards {
        grid-template-columns: repeat(2,1fr);
        gap: 10px;
    }

    .stat-card {
        padding: 14px;
    }

    .stat-card h3 {
        font-size: 22px;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .test-list {
        grid-template-columns: repeat(2,1fr);
    }

    .result-row {
        grid-template-columns: 1.5fr 1fr 1fr;
    }

    .result-row .range-input {
        grid-column: 1/-1;
    }

    .topbar h1 {
        font-size: 18px;
    }
}
</style>
</head>

<body>

<div id="lockScreen">
    <div class="lock-box">
        <div style="font-size:45px">🔬</div>
        <h2>Al-Juman Laboratory</h2>
        <p>Enter your application password</p>
        <input type="password" id="lockPassword" placeholder="Password">
        <button class="primary" style="width:100%" onclick="unlockApp()">Unlock</button>
        <p id="lockError" style="color:var(--danger)"></p>
        <small>Default password: 1234</small>
    </div>
</div>

<div class="app">

<aside class="sidebar" id="sidebar">

    <div class="brand">
        <div class="logo">🔬</div>
        <div>
            <h2>مختبر الجمان الجانبي</h2>
            <small>Laboratory Management</small>
        </div>
    </div>

    <button class="nav-button active" onclick="showPage('dashboard',this)">
        <span>🏠</span> الرئيسية
    </button>

    <button class="nav-button" onclick="showPage('newPatient',this)">
        <span>👤</span> مريض جديد
    </button>

    <button class="nav-button" onclick="showPage('history',this)">
        <span>📋</span> سجل المرضى
    </button>

    <button class="nav-button" onclick="showPage('tests',this)">
        <span>🧪</span> التحاليل والمجموعات
    </button>

    <button class="nav-button" onclick="showPage('statistics',this)">
        <span>📊</span> الإحصائيات
    </button>

    <button class="nav-button" onclick="showPage('settings',this)">
        <span>⚙️</span> الإعدادات
    </button>

    <div class="sidebar-footer">
        <button class="nav-button" onclick="lockApp()">
            <span>🔒</span> قفل التطبيق
        </button>

        <button class="nav-button" onclick="exportBackup()">
            <span>💾</span> النسخ الاحتياطي
        </button>
    </div>

</aside>

<main class="main">

    <header class="topbar">
        <div style="display:flex;align-items:center;gap:10px">
            <button class="secondary mobile-menu" onclick="toggleSidebar()">☰</button>
            <h1 id="pageTitle">الرئيسية</h1>
        </div>

        <div class="topbar-actions">
            <button class="secondary" onclick="toggleTheme()">🌙 / ☀️</button>
            <button class="secondary" onclick="lockApp()">🔒</button>
        </div>
    </header>

    <div class="content">

        <!-- DASHBOARD -->
        <section class="page active" id="dashboard">

            <div class="cards">

                <div class="stat-card">
                    <div class="icon">👥</div>
                    <h3 id="totalPatients">0</h3>
                    <p>إجمالي المرضى</p>
                </div>

                <div class="stat-card">
                    <div class="icon">📄</div>
                    <h3 id="totalReports">0</h3>
                    <p>إجمالي التقارير</p>
                </div>

                <div class="stat-card">
                    <div class="icon">🧪</div>
                    <h3 id="totalTests">0</h3>
                    <p>إجمالي التحاليل</p>
                </div>

                <div class="stat-card">
                    <div class="icon">📅</div>
                    <h3 id="todayReports">0</h3>
                    <p>تقارير اليوم</p>
                </div>

            </div>

            <div class="panel">
                <h2>⚡ إجراءات سريعة</h2>

                <div class="quick-actions">

                    <button class="quick-action" onclick="showPage('newPatient')">
                        <span class="icon">➕</span>
                        مريض جديد
                    </button>

                    <button class="quick-action" onclick="showPage('history')">
                        <span class="icon">🔍</span>
                        بحث عن مريض
                    </button>

                    <button class="quick-action" onclick="showPage('tests')">
                        <span class="icon">🧪</span>
                        التحاليل
                    </button>

                    <button class="quick-action" onclick="showPage('statistics')">
                        <span class="icon">📊</span>
                        الإحصائيات
                    </button>

                </div>
            </div>

            <div class="panel">
                <h2>آخر التقارير</h2>
                <div id="recentReports"></div>
            </div>

        </section>

        <!-- NEW PATIENT -->
        <section class="page" id="newPatient">

            <div class="panel">
                <h2>تسجيل مريض / زيارة جديدة</h2>

                <form id="patientForm">

                    <div class="form-grid">

                        <div class="form-group">
                            <label>اسم المريض الكامل *</label>
                            <input id="patientName" required>
                        </div>

                        <div class="form-group">
                            <label>Patient ID</label>
                            <input id="patientId" readonly>
                        </div>

                        <div class="form-group">
                            <label>العمر *</label>
                            <div style="display:flex;gap:8px">
                                <input id="patientAge" type="number" min="0" required>
                                <select id="ageUnit">
                                    <option value="Years">Years</option>
                                    <option value="Months">Months</option>
                                    <option value="Days">Days</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>الجنس *</label>
                            <select id="patientGender" required>
                                <option value="">اختر</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>تاريخ التحليل *</label>
                            <input id="analysisDate" type="date" required>
                        </div>

                        <div class="form-group">
                            <label>اسم الطبيب</label>
                            <input id="doctorName">
                        </div>

                        <div class="form-group">
                            <label>Report Number</label>
                            <input id="reportNumber" readonly>
                        </div>

                        <div class="form-group full">
                            <label>ملاحظات</label>
                            <textarea id="patientNotes"></textarea>
                        </div>

                    </div>

                    <div class="panel" style="margin-top:20px">
                        <h2>اختيار التحاليل</h2>
                        <input type="search" id="testSearch" placeholder="بحث عن تحليل..." oninput="renderTestSelection()">
                        <div id="testSelection"></div>
                    </div>

                    <div class="panel">
                        <h2>إدخال النتائج</h2>
                        <div id="resultInputs">
                            <div class="empty-state">اختر التحاليل أولاً</div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="primary">💾 حفظ التقرير</button>
                        <button type="button" class="secondary" onclick="resetPatientForm()">إعادة تعيين</button>
                    </div>

                </form>
            </div>

        </section>

        <!-- HISTORY -->
        <section class="page" id="history">

            <div class="panel">
                <h2>سجل المرضى والتقارير</h2>

                <input class="search-box" id="historySearch" type="search"
                       placeholder="بحث بالاسم أو Patient ID أو Report Number..."
                       oninput="renderHistory()">

                <div class="table-wrap">
                    <table>
                        <thead>
                        <tr>
                            <th>Report Number</th>
                            <th>Patient ID</th>
                            <th>اسم المريض</th>
                            <th>العمر</th>
                            <th>Gender</th>
                            <th>التاريخ</th>
                            <th>عدد التحاليل</th>
                            <th>الإجراءات</th>
                        </tr>
                        </thead>
                        <tbody id="historyTable"></tbody>
                    </table>
                </div>
            </div>

        </section>

        <!-- TEST MANAGEMENT -->
        <section class="page" id="tests">

            <div class="panel">
                <h2>إدارة التحاليل</h2>

                <div class="form-grid">

                    <div class="form-group">
                        <label>Test Name</label>
                        <input id="newTestName" placeholder="Example: CBC">
                    </div>

                    <div class="form-group">
                        <label>Category</label>
                        <select id="newTestCategory">
                            <option>Hematology</option>
                            <option>Biochemistry</option>
                            <option>Hormones</option>
                            <option>Immunology & Serology</option>
                            <option>Urine Analysis</option>
                            <option>Microbiology</option>
                            <option>Cardiac Markers</option>
                            <option>Other Tests</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Unit</label>
                        <input id="newTestUnit" placeholder="Example: mg/dL">
                    </div>

                    <div class="form-group">
                        <label>Male Reference Range</label>
                        <input id="newTestMaleRange">
                    </div>

                    <div class="form-group">
                        <label>Female Reference Range</label>
                        <input id="newTestFemaleRange">
                    </div>

                    <div class="form-group">
                        <label>General Reference Range</label>
                        <input id="newTestRange">
                    </div>

                </div>

                <button class="primary" onclick="addNewTest()">➕ إضافة تحليل</button>
            </div>

            <div class="panel">
                <h2>قائمة التحاليل</h2>
                <input type="search" id="manageTestSearch" placeholder="بحث..." oninput="renderTestManagement()">
                <div class="table-wrap">
                    <table>
                        <thead>
                        <tr>
                            <th>Test Name</th>
                            <th>Category</th>
                            <th>Unit</th>
                            <th>Reference Range</th>
                            <th>الإجراء</th>
                        </tr>
                        </thead>
                        <tbody id="testsTable"></tbody>
                    </table>
                </div>
            </div>

        </section>

        <!-- STATISTICS -->
        <section class="page" id="statistics">

            <div class="panel">
                <h2>الإحصائيات</h2>

                <div class="cards">

                    <div class="stat-card">
                        <div class="icon">👥</div>
                        <h3 id="statsPatients">0</h3>
                        <p>المرضى</p>
                    </div>

                    <div class="stat-card">
                        <div class="icon">📄</div>
                        <h3 id="statsReports">0</h3>
                        <p>التقارير</p>
                    </div>

                    <div class="stat-card">
                        <div class="icon">🧪</div>
                        <h3 id="statsTests">0</h3>
                        <p>التحاليل المنفذة</p>
                    </div>

                    <div class="stat-card">
                        <div class="icon">📅</div>
                        <h3 id="statsToday">0</h3>
                        <p>تقارير اليوم</p>
                    </div>

                </div>
            </div>

            <div class="panel">
                <h2>التحاليل الأكثر طلباً</h2>
                <div id="popularTests"></div>
            </div>

        </section>

        <!-- SETTINGS -->
        <section class="page" id="settings">

            <div class="panel">
                <h2>إعدادات المختبر</h2>

                <div class="form-grid">

                    <div class="form-group">
                        <label>اسم المختبر بالعربية</label>
                        <input id="labArabicName" value="مختبر الجمان الجانبي">
                    </div>

                    <div class="form-group">
                        <label>Laboratory Name</label>
                        <input id="labEnglishName" value="Al-Juman Al-Janabi Laboratory">
                    </div>

                    <div class="form-group">
                        <label>Phone</label>
                        <input id="labPhone" value="07831216789">
                    </div>

                    <div class="form-group">
                        <label>Address</label>
                        <input id="labAddress" value="الصقلاوية - الشهداء الثانية">
                    </div>

                    <div class="form-group">
                        <label>License Number</label>
                        <input id="labLicense">
                    </div>

                    <div class="form-group">
                        <label>Authorized Person</label>
                        <input id="labAuthorized">
                    </div>

                </div>

                <button class="primary" onclick="saveSettings()">💾 حفظ الإعدادات</button>
            </div>

            <div class="panel">
                <h2>إعدادات التطبيق</h2>

                <div class="settings-row">
                    <span>الوضع الفاتح / الداكن</span>
                    <button class="secondary" onclick="toggleTheme()">تغيير المظهر</button>
                </div>

                <div class="settings-row">
                    <span>تغيير كلمة المرور</span>
                    <button class="primary" onclick="changePassword()">تغيير</button>
                </div>

                <div class="settings-row">
                    <span>النسخ الاحتياطي</span>
                    <button class="success" onclick="exportBackup()">إنشاء نسخة</button>
                </div>

                <div class="settings-row">
                    <span>استعادة النسخة الاحتياطية</span>
                    <button class="secondary" onclick="document.getElementById('restoreFile').click()">استعادة</button>
